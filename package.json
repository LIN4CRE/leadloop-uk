{
  "name": "leadloop-uk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/core.test.js tests/db.test.js",
    "test:unit": "node --test tests/core.test.js tests/db.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css,html,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{js,mjs,json,css,html,md,yml,yaml}\"",
    "build:check": "node scripts/build-check.mjs",
    "build": "npm run build:check",
    "check": "npm run format:check && npm run test:unit && npm run build:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.6.2"
  }
}
